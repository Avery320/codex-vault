{
  "name": "codex-vault",
  "version": "0.1.0",
  "description": "A local Codex plugin for exploring and annotating Obsidian-compatible Markdown vaults.",
  "repository": "https://github.com/Avery320/codex-vault.git",
  "homepage": "https://github.com/Avery320/codex-vault#readme",
  "bugs": {
    "url": "https://github.com/Avery320/codex-vault/issues"
  },
  "author": "Avery Tsai",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "version-packages": "changeset version",
    "reset": "yarn && yarn clean && yarn build",
    "clean": "lerna run clean --ignore foam-vscode",
    "build": "lerna run build --ignore foam-vscode",
    "test": "lerna run test --ignore foam-vscode",
    "test:unit": "lerna run test:unit --ignore foam-vscode",
    "test:e2e": "lerna run test:e2e --ignore foam-vscode",
    "bench": "lerna run bench --ignore foam-vscode",
    "lint": "lerna run lint --ignore foam-vscode",
    "format": "prettier --write \"packages/foam-core/**/*.ts\" \"packages/foam-graph/**/*.ts\" \"packages/foam-mcp/**/*.ts\" \"packages/foam-cli/**/*.ts\"",
    "watch": "lerna run watch --ignore foam-vscode --concurrency 20",
    "mcp": "./scripts/launch_codex_vault_mcp",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "all-contributors-cli": "^6.16.1",
    "husky": "^9.1.7",
    "lerna": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "engines": {
    "node": ">=22"
  },
  "prettier": {
    "arrowParens": "avoid",
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
