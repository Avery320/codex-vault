{
  "name": "@foam/core",
  "version": "0.46.0",
  "description": "Platform-agnostic core logic for Foam",
  "license": "MIT",
  "main": "out/src/index.js",
  "types": "out/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.d.ts",
      "default": "./out/src/index.js"
    },
    "./test": {
      "types": "./out/test/test-utils.d.ts",
      "default": "./out/test/test-utils.js"
    },
    "./markdown-renderer": {
      "types": "./out/src/markdown/renderer/index.d.ts",
      "default": "./out/src/markdown/renderer/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "release": "node release.js",
    "tag-release": "node ../../scripts/tag-release.js core",
    "clean": "rimraf out",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "yarn bench",
    "bench": "vitest bench --run --config vitest.bench.config.ts",
    "bench:compare": "vitest run src/perf-regression.test.ts",
    "bench:seed": "node ../../scripts/perf/seed-baseline.mjs",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "markdown-it": "14.3.0",
    "markdown-it-regex": "^0.2.0",
    "oxlint": "^1.57.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "wait-for-expect": "^3.0.2"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "detect-newline": "^3.1.0",
    "github-slugger": "^1.4.0",
    "gray-matter": "^4.0.2",
    "js-sha1": "^0.7.0",
    "lodash": "^4.17.21",
    "lru-cache": "^11.0.0",
    "mnemonist": "^0.39.8",
    "remark-frontmatter": "^2.0.0",
    "remark-parse": "^8.0.2",
    "remark-wiki-link": "^0.0.4",
    "title-case": "^3.0.2",
    "unified": "^9.0.0",
    "unist-util-visit": "^2.0.2",
    "yaml": "^2.2.2"
  }
}
