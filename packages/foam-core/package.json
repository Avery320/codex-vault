{
  "name": "@foam/core",
  "version": "0.46.0",
  "description": "Codex Vault Markdown and knowledge graph core",
  "license": "MIT",
  "main": "out/src/index.js",
  "types": "out/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./out/src/index.d.ts",
      "default": "./out/src/index.js"
    },
    "./test": {
      "types": "./out/test/test-utils.d.ts",
      "default": "./out/test/test-utils.js"
    },
    "./markdown-renderer": {
      "types": "./out/src/markdown/renderer/index.d.ts",
      "default": "./out/src/markdown/renderer/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf out",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "lint": "oxlint src"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/micromatch": "^4.0.9",
    "markdown-it": "14.3.0",
    "micromatch": "^4.0.8",
    "markdown-it-regex": "^0.2.0",
    "oxlint": "^1.57.0",
    "rimraf": "^3.0.2",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "wait-for-expect": "^3.0.2"
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "detect-newline": "^3.1.0",
    "github-slugger": "^1.4.0",
    "gray-matter": "^4.0.2",
    "mnemonist": "^0.39.8",
    "remark-frontmatter": "^2.0.0",
    "remark-parse": "^8.0.2",
    "remark-wiki-link": "^0.0.4",
    "unified": "^9.0.0",
    "unist-util-visit": "^2.0.2",
    "yaml": "^2.2.2"
  }
}
