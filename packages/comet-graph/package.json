{
  "name": "@comet/graph-view",
  "version": "0.40.0",
  "description": "COMET knowledge graph web component",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/comet-graph.d.ts",
      "default": "./out/comet-graph.js"
    },
    "./protocol": {
      "types": "./out/protocol.d.ts",
      "default": "./out/protocol.js"
    }
  },
  "files": [
    "out/",
    "src/"
  ],
  "scripts": {
    "build": "node build.cjs",
    "build:lib": "node build.cjs --lib",
    "clean": "rimraf out dist",
    "test": "yarn test:unit",
    "test:unit": "vitest run",
    "lint": "oxlint src"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-color": "^3.1.3",
    "@types/d3-force": "^3.0.10",
    "@types/d3-scale": "^4.0.9",
    "d3-color": "^3.1.0",
    "d3-force": "^3.0.0",
    "d3-scale": "^4.0.0",
    "esbuild": "^0.28.1",
    "force-graph": "^1.51.0",
    "happy-dom": "^20.0.0",
    "lit": "^3.0.0",
    "oxlint": "^1.57.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0"
  }
}
