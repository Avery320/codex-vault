#!/usr/bin/env bash
set -euo pipefail

plugin_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cli_entry="${plugin_dir}/packages/foam-cli/out/index.js"
config_home="${XDG_CONFIG_HOME:-${HOME}/.config}"
registry_path="${CODEX_VAULT_REGISTRY_PATH:-${config_home}/codex-vault/vaults.json}"
obsidian_registry_path="${CODEX_OBSIDIAN_REGISTRY_PATH:-${HOME}/Library/Application Support/obsidian/obsidian.json}"

if [[ ! -f "${cli_entry}" ]]; then
  echo "Codex Vault is not built. Run 'yarn build' from ${plugin_dir}." >&2
  exit 1
fi

if [[ -n "${CODEX_MCP_NODE_PATH:-}" ]]; then
  node_binary="${CODEX_MCP_NODE_PATH}"
else
  node_binary="$(command -v node)"
fi

allow_writes="${CODEX_VAULT_ALLOW_WRITES:-}"
if [[ -z "${allow_writes}" && -f "${config_home}/codex-vault/allow-writes" ]]; then
  IFS= read -r allow_writes < "${config_home}/codex-vault/allow-writes" || true
fi

mcp_args=(
  mcp
  --vault-registry "${registry_path}"
  --obsidian-registry "${obsidian_registry_path}"
)
case "${allow_writes}" in
  1 | true | TRUE)
    mcp_args+=(--allow-writes)
    ;;
  "" | 0 | false | FALSE)
    ;;
  *)
    echo "Invalid CODEX_VAULT_ALLOW_WRITES value: ${allow_writes}" >&2
    exit 1
    ;;
esac

exec "${node_binary}" "${cli_entry}" "${mcp_args[@]}"
